rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function staffPath() {
      return /databases/$(database)/documents/staff/$(request.auth.uid);
    }

    function isStaff() {
      return request.auth != null
        && exists(staffPath())
        && get(staffPath()).data.active == true;
    }

    function isAdmin() {
      return isStaff() && get(staffPath()).data.role == 'admin';
    }

    function validStore() {
      return request.resource.data.products is list
        && request.resource.data.settings is map
        && request.resource.data.transactions is list
        && request.resource.data.revision is int
        && !('users' in request.resource.data);
    }

    match /stores/chomdoi_main {
      allow get: if isStaff();
      allow list, create, delete: if false;
      allow update: if isStaff()
        && validStore()
        && request.resource.data.revision == resource.data.get('revision', 0) + 1
        && (isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'products', 'transactions', 'restockLogs', 'shifts',
            'supplyChecks', 'supplyRestocks', 'revision'
          ]));
    }

    match /staff/{uid} {
      allow get, list: if isStaff();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'uid', 'legacyId', 'username', 'displayName', 'role', 'active'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.legacyId is string
        && request.resource.data.username is string
        && request.resource.data.displayName is string
        && request.resource.data.role in ['admin', 'user']
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
